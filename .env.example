NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://pingx:pingx@localhost:5432/pingx
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173
API_URL=http://localhost:4100
# Browser reaches the API under this prefix (Vite proxy in dev, Caddy in prod)
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=false

# openssl rand -base64 48  (different values, 32+ chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32 ; rotate by adding ENCRYPTION_KEY_V2 and setting ENCRYPTION_KEY_VERSION=2
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_VERSION=1

# seed: first admin user
ADMIN_EMAIL=admin@pingx.local
ADMIN_PASSWORD=

# System emails (verify, reset, limit warnings). Empty = printed to the worker console.
# Dev: Mailpit from docker compose, inbox at http://localhost:8025
SYSTEM_SMTP_URL=smtp://localhost:1025
SYSTEM_FROM=PingX <no-reply@pingx.local>

# Google sign-in + Gmail OAuth provider (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# AI template assistant (optional)
ANTHROPIC_API_KEY=

# Signup captcha: Cloudflare Turnstile (optional)
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# spikes/smtp-egress
SMTP_HOST=smtp.gmail.com
SMTP_USER=
SMTP_PASS=
SMTP_TO=
