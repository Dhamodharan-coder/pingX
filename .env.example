NODE_ENV=development
PORT=4100
DATABASE_URL=postgresql://pingx:pingx@localhost:5432/pingx
DIRECT_URL=postgresql://pingx:pingx@localhost:5432/pingx
REDIS_URL=redis://localhost:6379
APP_URL=http://localhost:5173
API_URL=http://localhost:4100
# Browser reaches the API under this prefix (Vite proxy in dev, Caddy in prod)
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=false

# openssl rand -base64 48  (different values, 32+ chars)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32 ; rotate by adding ENCRYPTION_KEY_V2 and setting ENCRYPTION_KEY_VERSION=2
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_VERSION=1

# seed: first admin user
ADMIN_EMAIL=admin@pingx.local
ADMIN_PASSWORD=

# PingX's own emails: verify email, password reset, limit warnings.
# EMAIL_ENABLED="true" turns on email verification; anything else = no verification step at all.
EMAIL_ENABLED="true"
# Provider is picked automatically: SMTP (if SMTP_HOST or SMTP_URL is set), else Resend, else console.
# Test your settings with: pnpm email:test you@example.com
EMAIL_FROM="PingX <no-reply@pingx.local>"
# SMTP via Nodemailer (Gmail, Outlook, Zoho, SES, Brevo, Mailgun, ...). Local dev: Mailpit, inbox at http://localhost:8025
SMTP_HOST="localhost"
SMTP_PORT="1025"
# "true" only for port 465 (implicit TLS)
SMTP_SECURE="false"
SMTP_USER=
SMTP_PASS=
# Or one URL instead of the fields above, e.g. smtps://user:pass@smtp.zoho.in:465
SMTP_URL=
# Used only when no SMTP is set
RESEND_API_KEY=

# Google sign-in + Gmail OAuth provider (optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=

# Razorpay (optional)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=


# Signup captcha: Cloudflare Turnstile (optional)
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=

# spikes/smtp-egress also uses SMTP_HOST/SMTP_USER/SMTP_PASS above; SMTP_TO = where its test mail goes
SMTP_TO=
