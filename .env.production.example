# Production settings for the Oracle VM (docker-compose.vm.yml). Copy to .env.production on the VM.
# Never commit the real file. See docs/deploy.md.
NODE_ENV=production

# --- Addresses -------------------------------------------------------------
# The VM's public HTTPS name. No domain? Use your VM's IP with sslip.io, e.g. api.140-245-12-34.sslip.io
API_DOMAIN=api.140-245-12-34.sslip.io
ACME_EMAIL=you@example.com
# Your Vercel dashboard URL. The browser and SDK clients reach the API through it at /api.
APP_URL=https://pingx-yourname.vercel.app
API_URL=https://pingx-yourname.vercel.app/api
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=true
# Visitor → Vercel → Caddy → API: two proxies
TRUST_PROXY=2
PORT=4100

# --- Neon -------------------------------------------------------------------
# Pooled connection (host contains -pooler); keep pgbouncer=true
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/pingx?sslmode=require&pgbouncer=true&connect_timeout=15
# Direct connection (same, without -pooler) — used for migrations
DIRECT_URL=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/pingx?sslmode=require&connect_timeout=15

# Redis runs on the VM (docker-compose.vm.yml sets REDIS_URL=redis://redis:6379)

# --- Secrets (generate new ones; never reuse dev values) ------------------
# openssl rand -base64 48   (two different values)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# openssl rand -base64 32 — back it up offline: losing it loses every saved provider credential
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_VERSION=1

# First admin (created by the migrate service on first run)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- PingX's own emails (verification, password reset, limit warnings) -----
EMAIL_ENABLED=true
EMAIL_FROM=PingX <you@gmail.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_URL=
RESEND_API_KEY=

# --- Optional integrations -------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TURNSTILE_SECRET=
