# Copy to .env.production on the server. Never commit the real file.
NODE_ENV=production
DOMAIN=pingx.example.com
ACME_EMAIL=you@example.com

POSTGRES_USER=pingx
POSTGRES_PASSWORD=
POSTGRES_DB=pingx
DATABASE_URL=postgresql://pingx:CHANGE_ME@postgres:5432/pingx
REDIS_URL=redis://redis:6379

PORT=4100
APP_URL=https://pingx.example.com
API_URL=https://pingx.example.com/api
PUBLIC_API_PREFIX=/api
COOKIE_SECURE=true

JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ENCRYPTION_KEY_V1=
ENCRYPTION_KEY_VERSION=1

ADMIN_EMAIL=
ADMIN_PASSWORD=

EMAIL_ENABLED=true
EMAIL_FROM=PingX <no-reply@pingx.example.com>
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_URL=
RESEND_API_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
VITE_GOOGLE_CLIENT_ID=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
TURNSTILE_SECRET=
VITE_TURNSTILE_SITE_KEY=
BACKUP_KEEP_DAYS=14
