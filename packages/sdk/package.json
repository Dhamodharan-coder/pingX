{
  "name": "pingx",
  "version": "0.0.1",
  "description": "Official SDK for PingX",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "license": "MIT",
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc",
    "test": "vitest run"
  },
  "devDependencies": {
    "tsup": "^9.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "email",
    "smtp",
    "transactional",
    "sdk"
  ]
}
