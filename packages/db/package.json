{
  "name": "@pingx/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./testing/global-setup": "./testing/global-setup.ts",
    "./testing/env": "./testing/env.ts"
  },
  "scripts": {
    "generate": "prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "seed": "tsx --env-file-if-exists=../../.env prisma/seed.ts",
    "typecheck": "tsc",
    "deploy": "prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@pingx/shared": "workspace:*",
    "@prisma/client": "^6.19.3"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "ioredis": "^6.0.0",
    "prisma": "^6.19.3",
    "tsx": "^4.23.15"
  }
}
