{
  "name": "pingx-monorepo",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@pingx/api --filter=@pingx/worker --filter=@pingx/dashboard",
    "build": "turbo run build",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "db:migrate": "pnpm --filter @pingx/db migrate",
    "db:seed": "pnpm --filter @pingx/db seed",
    "db:generate": "pnpm --filter @pingx/db generate",
    "check:bundle": "node scripts/check-bundle-deps.mjs",
    "db:studio": "pnpm --filter @pingx/db studio",
    "email:test": "pnpm --filter @pingx/worker email:test"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
